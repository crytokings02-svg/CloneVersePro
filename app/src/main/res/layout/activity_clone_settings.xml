<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F6FA">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient" android:gravity="center_vertical"
        android:orientation="horizontal" android:padding="16dp">
        <FrameLayout android:layout_width="62dp" android:layout_height="62dp"
            android:background="@drawable/bg_icon_tile">
            <ImageView android:id="@+id/ivIcon" android:layout_width="52dp"
                android:layout_height="52dp" android:layout_gravity="center" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/tvAppName" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#FFFFFF"
                android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvPkg" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#D6DCFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">

            <!-- ONE CLICK -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewIdentity" android:layout_width="match_parent"
                android:layout_height="56dp" android:text="✨ OPEN A NEW IDENTITY WITH ONE CLICK"
                android:textSize="14sp" app:backgroundTint="#FF6D00"
                app:cornerRadius="16dp" />

            <!-- DEVICE CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" app:cardCornerRadius="18dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📱 Virtual Device" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Clone ko konsa phone samjha jaye? Har clone ko alag device bhi mil sakta hai."
                        android:textSize="12sp" android:textColor="#5F6368" />
                    <TextView android:id="@+id/tvDeviceNow" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:textSize="15sp" android:textStyle="bold" android:textColor="#3F51B5" />
                    <TextView android:id="@+id/tvDeviceDetail" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="11sp"
                        android:textColor="#80838C" />
                    <Spinner android:id="@+id/spinnerDevice" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                    <Switch android:id="@+id/swRuntime" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true"
                        android:text="Device Runtime inject karo (Model/Brand clone ke andar asal badlega)" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Kitne Clone banane hain?"
                        android:textSize="14sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <Button android:id="@+id/btnMinus" android:layout_width="44dp"
                            android:layout_height="44dp" android:text="−" />
                        <TextView android:id="@+id/tvCount" android:layout_width="54dp"
                            android:layout_height="wrap_content" android:gravity="center"
                            android:text="1" android:textSize="20sp" android:textStyle="bold" />
                        <Button android:id="@+id/btnPlus" android:layout_width="44dp"
                            android:layout_height="44dp" android:text="+" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" android:text="(1 – 5) har clone ki alag identity"
                            android:textSize="11sp" android:textColor="#80838C" />
                    </LinearLayout>
                    <Switch android:id="@+id/swRandomDeviceEach" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true"
                        android:text="Har clone ko alag Random Device do (Multiple Devices)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Android ID -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" app:cardCornerRadius="18dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <Switch android:id="@+id/swAndroidId" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:checked="true"
                        android:text="Android ID" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Report the changed Android ID to the cloned application to prevent obtaining the native Android ID"
                        android:textSize="12sp" android:textColor="#5F6368" />
                    <EditText android:id="@+id/etAndroidId" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="Android ID"
                        android:maxLines="1" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- IMEI IMSI -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" app:cardCornerRadius="18dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <Switch android:id="@+id/swImei" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:checked="true"
                        android:text="IMEI / IMSI" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Change the IMEI/IMSI number of the phone in the clone application"
                        android:textSize="12sp" android:textColor="#5F6368" />
                    <EditText android:id="@+id/etImei1" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="IMEI 1"
                        android:inputType="number" android:maxLines="1" android:textSize="13sp" />
                    <EditText android:id="@+id/etImei2" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="IMEI 2"
                        android:inputType="number" android:maxLines="1" android:textSize="13sp" />
                    <EditText android:id="@+id/etImsi" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="IMSI"
                        android:inputType="number" android:maxLines="1" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MAC -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" app:cardCornerRadius="18dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <Switch android:id="@+id/swWifiMac" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:checked="true"
                        android:text="WiFi / Bluetooth MAC address" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Change your WiFi/Bluetooth mac address"
                        android:textSize="12sp" android:textColor="#5F6368" />
                    <EditText android:id="@+id/etWifiMac" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="WiFi MAC"
                        android:maxLines="1" android:textSize="13sp" />
                    <EditText android:id="@+id/etBluetoothMac" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="Bluetooth MAC"
                        android:maxLines="1" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AD ID -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" app:cardCornerRadius="18dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <Switch android:id="@+id/swAdId" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:checked="true"
                        android:text="Google Advertising ID" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Report a random Google advertising ID to the cloned application to prevent it from being tracked by advertising"
                        android:textSize="12sp" android:textColor="#5F6368" />
                    <EditText android:id="@+id/etAdId" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="Advertising ID (UUID)"
                        android:maxLines="1" android:textSize="13sp" />
                    <EditText android:id="@+id/etGsfId" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="GSF ID"
                        android:maxLines="1" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SIM : sirf ON/OFF, koi carrier nahi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" app:cardCornerRadius="18dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <Switch android:id="@+id/swSim" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:checked="true"
                        android:text="SIM card and carrier information" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Hide local SIM card serial number, phone number, phone location, carrier identifier/ name/country and other information"
                        android:textSize="12sp" android:textColor="#5F6368" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textSize="12sp" android:textColor="#80838C"
                android:text="Note: Split APK, banking aur signature-check wali apps kabhi kabhi clone run na karein. Test pehle kisi chhoti app par karein." />
        </LinearLayout>
    </ScrollView>

    <!-- Neeche chipka hua CLONE button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClone" android:layout_width="match_parent"
        android:layout_height="60dp" android:layout_margin="14dp"
        android:text="CLONE KARO" android:textSize="16sp"
        app:backgroundTint="#2E7D32" app:cornerRadius="18dp" />
</LinearLayout>
