<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F6FA">

    <!-- Header with Logo -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical" android:padding="20dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="56dp" android:layout_height="56dp"
                android:src="@mipmap/ic_launcher" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CloneVerse Pro" android:textColor="#FFFFFF"
                    android:textSize="26sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="App Cloner • One Click New Identity"
                    android:textColor="#D6DCFF" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_green" android:paddingHorizontal="12dp"
                android:paddingVertical="5dp" android:text="v2.0"
                android:textColor="#FFFFFF" android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" app:cardCornerRadius="16dp" app:cardElevation="2dp">
            <EditText android:id="@+id/etSearch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@null"
                android:hint="🔍  App search karo..."
                android:inputType="text" android:maxLines="1" android:padding="14dp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Stats / Buttons -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginEnd="6dp" android:layout_weight="1"
            app:cardCornerRadius="16dp" app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:id="@+id/tvAppsCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="..."
                    android:textSize="20sp" android:textStyle="bold" android:textColor="#3F51B5" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Phone ki Apps" android:textSize="12sp" android:textColor="#5F6368" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMyClones"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:layout_weight="1"
            app:cardBackgroundColor="#3F51B5"
            app:cardCornerRadius="16dp" app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:id="@+id/tvClonesCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="My Clones ›" android:textColor="#D6DCFF" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <Switch android:id="@+id/swSystemApps" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="System apps bhi dikhao (Saari apps)" />

    <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp" android:text="Apps load ho rahi hain..."
        android:textColor="#5F6368" android:textSize="13sp" />

    <ListView android:id="@+id/listApps" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_marginTop="6dp"
        android:layout_weight="1" android:divider="@null"
        android:paddingHorizontal="10dp" />
</LinearLayout>
