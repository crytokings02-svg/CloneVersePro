<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="My Clones" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Kisi clone par click karo: Install / Launch / Identity dekho / Delete" android:textSize="13sp" />
    <ListView android:id="@+id/listClones" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_weight="1" />
</LinearLayout>
